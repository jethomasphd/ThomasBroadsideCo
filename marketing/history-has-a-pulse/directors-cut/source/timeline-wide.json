  "narration": [
    {
      "id": "pulse",
      "text": "History has a pulse.",
      "at": 0.55,
      "tempo": 1,
      "duration": 1.996916,
      "file": "audio/pulse.mp3"
    },
    {
      "id": "listen",
      "text": "Just listen.",
      "at": 3.6,
      "tempo": 1,
      "duration": 1.346757,
      "file": "audio/listen.mp3"
    },
    {
      "id": "founding",
      "text": "In seventeen seventy-six, the Declaration entered a print shop. The words had to reach the people.",
      "at": 9.3,
      "tempo": 1,
      "duration": 9.102222,
      "file": "audio/founding.mp3"
    },
    {
      "id": "public",
      "text": "The spirit of printing transforms a working draft into a printed sheet.",
      "at": 19.1,
      "tempo": 1,
      "duration": 5.897868,
      "file": "audio/public.mp3"
    },
    {
      "id": "farther",
      "text": "And a voice carried farther.",
      "at": 25.6,
      "tempo": 1,
      "duration": 2.832834,
      "file": "audio/farther.mp3"
    },
    {
      "id": "inheritance",
      "text": "The inheritance of printing reaches beyond the founding of America.",
      "at": 28.9,
      "tempo": 1,
      "duration": 5.526349,
      "file": "audio/inheritance.mp3"
    },
    {
      "id": "wisdom",
      "text": "The search for wisdom.",
      "at": 35.1,
      "tempo": 1,
      "duration": 1.996916,
      "file": "audio/wisdom.mp3"
    },
    {
      "id": "mercy",
      "text": "The call to mercy.",
      "at": 38.7,
      "tempo": 1,
      "duration": 2.136236,
      "file": "audio/mercy.mp3"
    },
    {
      "id": "courage",
      "text": "The courage to find our way.",
      "at": 43.2,
      "tempo": 1,
      "duration": 2.693515,
      "file": "audio/courage.mp3"
    },
    {
      "id": "austin",
      "text": "Here in Austin, we give enduring words a place on the page.",
      "at": 47.2,
      "tempo": 1,
      "duration": 5.851429,
      "file": "audio/austin.mp3"
    },
    {
      "id": "craft",
      "text": "Ink. Paper. A working press. A tradition, carried forward.",
      "at": 55.2,
      "tempo": 1,
      "duration": 6.826667,
      "file": "audio/craft.mp3"
    },
    {
      "id": "read",
      "text": "Read the words.",
      "at": 62.7,
      "tempo": 1,
      "duration": 1.671837,
      "file": "audio/read.mp3"
    },
    {
      "id": "keep",
      "text": "Keep the source.",
      "at": 65.1,
      "tempo": 1,
      "duration": 1.578957,
      "file": "audio/keep.mp3"
    },
    {
      "id": "enduring",
      "text": "Make room for the enduring.",
      "at": 67.1,
      "tempo": 1,
      "duration": 2.600635,
      "file": "audio/enduring.mp3"
    },
    {
      "id": "company",
      "text": "Thomas Broadside Company.",
      "at": 70.1,
      "tempo": 1,
      "duration": 2.600635,
      "file": "audio/company.mp3"
    },
    {
      "id": "motto",
      "text": "Words to live with.",
      "at": 72.9,
      "tempo": 1,
      "duration": 2.043356,
      "file": "audio/motto.mp3"
    }
  ],
