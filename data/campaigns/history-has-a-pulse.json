  "narration": [
    {
      "id": "pulse",
      "text": "History has a pulse. Listen.",
      "at": 1.8,
      "tempo": 0.82,
      "duration": 2.0388256097560977,
      "file": "audio/pulse.mp3"
    },
    {
      "id": "founding",
      "text": "In seventeen seventy-six, the Declaration entered a print shop. The words had to reach the people.",
      "at": 6.1,
      "tempo": 0.82,
      "duration": 6.682815853658537,
      "file": "audio/founding.mp3"
    },
    {
      "id": "public",
      "text": "A working draft. A printed sheet. A voice, carried farther.",
      "at": 14.5,
      "tempo": 0.82,
      "duration": 4.247552439024391,
      "file": "audio/public.mp3"
    },
    {
      "id": "inheritance",
      "text": "The inheritance reaches beyond the founding.",
