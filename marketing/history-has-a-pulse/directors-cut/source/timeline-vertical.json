  "narration": [
    {
      "id": "pulse",
      "text": "History has a pulse. Listen.",
      "at": 1.8,
      "tempo": 0.82,
      "duration": 2.0388256097560977,
      "file": "audio/pulse.mp3"
    },
    {
      "id": "founding",
      "text": "In seventeen seventy-six, the Declaration entered a print shop. The words had to reach the people.",
      "at": 6.1,
      "tempo": 0.82,
      "duration": 6.682815853658537,
      "file": "audio/founding.mp3"
    },
    {
      "id": "public",
      "text": "A working draft. A printed sheet. A voice, carried farther.",
      "at": 14.5,
      "tempo": 0.82,
      "duration": 4.247552439024391,
      "file": "audio/public.mp3"
    },
    {
      "id": "inheritance",
      "text": "The inheritance reaches beyond the founding.",
      "at": 21.3,
      "tempo": 0.82,
      "duration": 2.775068292682927,
      "file": "audio/inheritance.mp3"
    },
    {
      "id": "wisdom",
      "text": "The search for wisdom.",
      "at": 25.8,
      "tempo": 0.86,
      "duration": 1.997996511627907,
      "file": "audio/wisdom.mp3"
    },
    {
      "id": "mercy",
      "text": "The call to mercy.",
      "at": 29.4,
      "tempo": 0.86,
      "duration": 1.889996511627907,
      "file": "audio/mercy.mp3"
    },
    {
      "id": "courage",
      "text": "The courage to find our way.",
      "at": 33.2,
      "tempo": 0.86,
      "duration": 2.321995348837209,
      "file": "audio/courage.mp3"
    },
    {
      "id": "austin",
      "text": "Here in Austin, we give enduring words a place on the page.",
      "at": 36.5,
      "tempo": 0.82,
      "duration": 3.907748780487805,
      "file": "audio/austin.mp3"
    },
    {
      "id": "craft",
      "text": "Ink. Paper. A working press. A tradition, carried forward.",
      "at": 44.1,
      "tempo": 0.82,
      "duration": 6.003207317073171,
      "file": "audio/craft.mp3"
    },
    {
      "id": "invitation",
      "text": "Read the words. Keep the source. Make room for the enduring.",
      "at": 51,
      "tempo": 0.82,
      "duration": 3.9643829268292685,
      "file": "audio/invitation.mp3"
    },
    {
      "id": "closing",
      "text": "Thomas Broadside Company. Build something that lasts.",
      "at": 55.6,
      "tempo": 0.82,
      "duration": 4.1342841463414635,
      "file": "audio/closing.mp3"
    }
  ]
}
